<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Photo fills the full visible card area (height set in DatingAdapter) -->
            <FrameLayout
                android:id="@+id/photoFrame"
                android:layout_width="match_parent"
                android:layout_height="460dp">

                <ImageView
                    android:id="@+id/userImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Dark gradient at bottom of photo -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/card_gradient_overlay" />

                <!-- Report button -->
                <ImageView
                    android:id="@+id/reportUser"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="#55000000"
                    android:padding="6dp"
                    android:src="@drawable/ic_baseline_more_horiz_24" />

                <!-- Name + location overlaid on gradient -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Name"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/countryIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_baseline_place_24"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/country"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-condensed"
                            android:text="Location"
                            android:textColor="#DDFFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Details below photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/bioShow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="About me"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="My basics"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/education"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/education"/>
                            <TextView android:id="@+id/educationTxt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="School"
                                android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/gender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/user"/>
                            <TextView android:id="@+id/genderTxt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Gender"
                                android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/height"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/height"/>
                            <TextView android:id="@+id/heightTxt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Height"
                                android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/exercise"/>
                            <TextView android:id="@+id/exerciseTxt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Exercise"
                                android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star"/>
                            <TextView android:id="@+id/starTxt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Star sign"
                                android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <TextView
                    android:id="@+id/interestText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="My Interests"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/interest1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:cardBackgroundColor="@color/surface_variant" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:id="@+id/interest1Image" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/education"/>
                            <TextView android:id="@+id/interest1Txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Interest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/interest2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:visibility="gone" app:cardBackgroundColor="@color/surface_variant" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:id="@+id/interest2Image" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/user"/>
                            <TextView android:id="@+id/interest2Txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Interest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/interest3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:visibility="gone" app:cardBackgroundColor="@color/surface_variant" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:id="@+id/interest3Image" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/height"/>
                            <TextView android:id="@+id/interest3Txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Interest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/interest4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:cardBackgroundColor="@color/surface_variant" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:id="@+id/interest4Image" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/exercise"/>
                            <TextView android:id="@+id/interest4Txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Interest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/interest5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:visibility="gone" app:cardBackgroundColor="@color/surface_variant" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:id="@+id/interest5Image" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star"/>
                            <TextView android:id="@+id/interest5Txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Interest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView android:id="@+id/interest6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:visibility="gone" app:cardBackgroundColor="@color/surface_variant" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp" android:layout_marginVertical="6dp" android:orientation="horizontal">
                            <ImageView android:id="@+id/interest6Image" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/star"/>
                            <TextView android:id="@+id/interest6Txt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:fontFamily="sans-serif-condensed" android:text="Interest" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <ImageView android:id="@+id/image1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_baseline_person_24" android:visibility="gone"/>
                <ImageView android:id="@+id/image2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_baseline_person_24" android:visibility="gone"/>
                <ImageView android:id="@+id/image3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_baseline_person_24" android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</com.google.android.material.card.MaterialCardView>
